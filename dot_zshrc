# ═════════════════════════════════════════════════════════════
#  FUNCTIONS
# ═════════════════════════════════════════════════════════════

# learn — capability guides per tool: "what can this do that I don't know about?"
#   learn tmux     open that tool's guide
#   learn          fuzzy-pick one
learn() {
  local dir="$HOME/.rig/learn" f
  if [[ -n "$1" ]]; then
    f="$dir/$1.md"
    [[ -f "$f" ]] || { echo "no guide for '$1'. available:"; ls "$dir" | sed 's/\.md$//;s/^/  /'; return 1; }
  else
    f=$(fd -e md . "$dir" | fzf --preview 'glow -s dark {}' --preview-window=right:65%)
    [[ -z "$f" ]] && return 0
  fi
  glow -p "$f"
}

# rig — manage this machine's config repo
#   rig            apply pending changes
#   rig edit       open the source repo in the editor
#   rig update     git pull + apply (run this on every machine)
#   rig diff       what would change
#   rig add <f>    start tracking a file
rig() {
  case "${1:-apply}" in
    apply)  chezmoi apply -v ;;
    edit)   ${EDITOR:-zed} "$(chezmoi source-path)" ;;
    update) chezmoi update -v ;;
    diff)   chezmoi diff ;;
    add)    shift; chezmoi add "$@" && echo "tracked. commit in $(chezmoi source-path)" ;;
    cd)     cd "$(chezmoi source-path)" ;;
    *)      chezmoi "$@" ;;
  esac
}

# mkcd — make a directory and cd into it
mkcd() { mkdir -p "$1" && cd "$1"; }

# fcd — fuzzy-pick a project under ~/dev and cd there
fcd() {
  local dir
  dir=$(fd --type d --max-depth 3 . ~/dev | fzf --preview 'eza --tree --level=2 --color=always {}') \
    && cd "$dir"
}

# fkill — fuzzy-pick a process and kill it
fkill() {
  local pid
  pid=$(ps -ef | sed 1d | fzf -m --header='[kill:process]' | awk '{print $2}')
  [[ -n "$pid" ]] && echo "$pid" | xargs kill -${1:-9}
}

# gwt — create a git worktree + branch in ../<repo>-worktrees/<name>, then cd there.
#       This is the primitive for running parallel AI agents without conflicts.
gwt() {
  [[ -z "$1" ]] && { echo "usage: gwt <branch-name>"; return 1; }
  local root name dir
  root=$(git rev-parse --show-toplevel) || return 1
  name=$(basename "$root")
  dir="$(dirname "$root")/${name}-worktrees/$1"
  git worktree add -b "$1" "$dir" && cd "$dir"
}

# gwtrm — remove a worktree and delete its branch
gwtrm() {
  [[ -z "$1" ]] && { echo "usage: gwtrm <branch-name>"; return 1; }
  local root name dir
  root=$(git rev-parse --show-toplevel) || return 1
  name=$(basename "$root")
  dir="$(dirname "$root")/${name}-worktrees/$1"
  git worktree remove "$dir" --force && git branch -D "$1"
}

# extract — unpack any archive
extract() {
  case "$1" in
    *.tar.bz2) tar xjf "$1" ;;  *.tar.gz)  tar xzf "$1" ;;
    *.tar.xz)  tar xJf "$1" ;;  *.tar)     tar xf  "$1" ;;
    *.bz2)     bunzip2 "$1" ;;  *.gz)      gunzip  "$1" ;;
    *.zip)     unzip   "$1" ;;  *.7z)      7z x    "$1" ;;
    *) echo "don't know how to extract '$1'" ;;
  esac
}

# y — yazi file manager that cds the shell to wherever you exited
y() {
  local tmp cwd
  tmp="$(mktemp -t yazi-cwd.XXXXXX)"
  yazi "$@" --cwd-file="$tmp"
  cwd="$(cat -- "$tmp")"
  [[ -n "$cwd" && "$cwd" != "$PWD" ]] && builtin cd -- "$cwd"
  rm -f -- "$tmp"
}

