# ─────────────────────────────────────────────────────────────
#  ~/.zshrc — Hugo
# ─────────────────────────────────────────────────────────────

# ---------- History ----------
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt SHARE_HISTORY          # share history live across open shells
setopt HIST_IGNORE_ALL_DUPS   # dedupe
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY            # expand !! before running
setopt EXTENDED_HISTORY       # record timestamps

# ---------- Shell behaviour ----------
setopt AUTO_CD                # `dev` instead of `cd dev`
setopt AUTO_PUSHD             # every cd pushes to the dir stack
setopt PUSHD_IGNORE_DUPS
setopt INTERACTIVE_COMMENTS   # allow # comments when typing
setopt NO_BEEP

# ---------- Completions ----------
fpath=(/opt/homebrew/share/zsh-completions $fpath)   # extra completion defs
autoload -Uz compinit
compinit -C                                       # -C = skip the daily security check (fast startup)
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'   # case-insensitive
zstyle ':completion:*' menu select                          # arrow-key menu
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# ---------- Keybindings ----------
bindkey -e                                    # emacs mode (ctrl-a / ctrl-e / ctrl-w)
bindkey '^[[A' history-search-backward        # Up  = search history by prefix
bindkey '^[[B' history-search-forward         # Down
bindkey '^[[1;3D' backward-word               # Option+Left
bindkey '^[[1;3C' forward-word                # Option+Right

# ---------- Editor ----------
export EDITOR="zed --wait"
export VISUAL="$EDITOR"
export PAGER="less -FRX"

# ═════════════════════════════════════════════════════════════
#  TOOL INITIALISATION
# ═════════════════════════════════════════════════════════════

# starship — the prompt
eval "$(starship init zsh)"

# zoxide — smarter cd that learns your habits.  `z hill` jumps to ~/dev/hill
eval "$(zoxide init zsh)"

# atuin — searchable, synced shell history.  Ctrl-R is now a fuzzy TUI
eval "$(atuin init zsh --disable-up-arrow)"

# direnv — auto-loads/unloads .envrc per directory
eval "$(direnv hook zsh)"

# mise — per-project runtime versions (node, python, terraform…)
eval "$(mise activate zsh)"

# fzf — fuzzy finder.  Ctrl-T files, Alt-C cd, Ctrl-R (taken by atuin)
source <(fzf --zsh)
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS='
  --height 60% --layout=reverse --border=rounded --info=inline
  --preview-window=right:55%:wrap
'
export FZF_CTRL_T_OPTS="--preview 'bat --style=numbers --color=always --line-range :300 {}'"
export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --color=always {}'"

# ═════════════════════════════════════════════════════════════
#  ZSH PLUGINS
# ═════════════════════════════════════════════════════════════

# zsh-autosuggestions — the greyed-out inline completion from your history.
# Start typing, it suggests the rest. → or End accepts it; Ctrl-→ accepts one word.
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh 2>/dev/null
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#6c7086'
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
bindkey '^[[1;5C' forward-word          # Ctrl-Right: accept one word of the suggestion

# NOTE: zsh-syntax-highlighting is sourced at the very BOTTOM of this file.
# It has to load after everything else that binds keyboard widgets.

