#!/bin/bash
# run_onchange_after_ → re-runs whenever this script's rendered content changes.
#
# The Brewfile hash below is what makes that work: edit the Brewfile, the hash
# changes, chezmoi re-runs this on the next `chezmoi update` on every machine.
# Without the hash line it would only ever run once.
#
# Brewfile hash: {{ include "Brewfile" | sha256sum }}

set -euo pipefail

echo "▶ brew bundle"

if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

command -v brew >/dev/null 2>&1 || { echo "  brew not found, skipping"; exit 0; }

BREWFILE="{{ .chezmoi.sourceDir }}/Brewfile"
[[ -f "$BREWFILE" ]] || { echo "  no Brewfile at $BREWFILE"; exit 0; }

brew update

# ---------- Mac App Store ----------
# mas 7 removed `mas account`, so there is no longer a way to check the App Store
# sign-in up front (the old check always failed → every mas entry was silently
# skipped). mas 7 also runs its installs through sudo, which needs a terminal to
# ask for the password. So: attempt the App Store apps only when there's a
# terminal, and let a missing sign-in fail those entries without failing the run.
mas_ids="$(grep -oE "id: [0-9]+" "$BREWFILE" | awk '{print $2}' | tr '\n' ' ')"
if [[ -t 0 ]]; then
  echo "  App Store apps: needs you signed into the App Store; mas may ask for your password."
else
  echo "  ⚠ no terminal for mas's sudo prompt — App Store entries skipped."
  echo "    From a terminal: brew bundle install --file=$BREWFILE"
  export HOMEBREW_BUNDLE_MAS_SKIP="$mas_ids"
fi

# ---------- Claude desktop app ----------
# Installing the `claude` cask over a Claude.app that's running, or that was
# installed outside Homebrew (the usual case: you're running this setup from it),
# can leave a half-finished upgrade in /opt/homebrew/Caskroom/claude and a broken
# app. Skip it in that case; adopt it later with Claude quit:
#   brew install --cask --force claude
claude_running() { ps -axo comm= | grep -qx '/Applications/Claude.app/Contents/MacOS/Claude'; }
if claude_running ||
  { [[ -d /Applications/Claude.app ]] && ! brew list --cask claude >/dev/null 2>&1; }; then
  echo "  Claude.app is running or not Homebrew-managed — skipping the claude cask."
  export HOMEBREW_BUNDLE_CASK_SKIP="${HOMEBREW_BUNDLE_CASK_SKIP:-} claude"
fi

brew bundle install --file="$BREWFILE" || {
  echo "  ⚠ some entries failed. Re-run: brew bundle install --file=$BREWFILE"
}

# ---------- zsh completion dirs ----------
# The Homebrew installer leaves $(brew --prefix)/share group-writable, and
# .zshrc's daily `compinit` audit then stops every new shell with "insecure
# directories". Group-writable fpath dirs are a real code-injection risk, so fix
# the permission rather than silencing the audit.
chmod go-w "$(brew --prefix)/share" "$(brew --prefix)/share/zsh" "$(brew --prefix)/share/zsh/site-functions" 2>/dev/null || true

echo "  done"
