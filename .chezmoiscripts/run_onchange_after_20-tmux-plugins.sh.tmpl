#!/bin/bash
# Installs TPM (the tmux plugin manager) and every plugin declared in
# .tmux.conf, without needing to press prefix+I by hand on a new machine.
#
# tmux.conf hash: {{ include "dot_tmux.conf" | sha256sum }}

set -euo pipefail

echo "▶ tmux plugins"

TPM_DIR="$HOME/.tmux/plugins/tpm"

if [[ ! -d "$TPM_DIR" ]]; then
  echo "  cloning TPM…"
  git clone --depth 1 https://github.com/tmux-plugins/tpm "$TPM_DIR"
fi

# install_plugins reads ~/.tmux.conf directly, so it works with no tmux server.
if [[ -x "$TPM_DIR/bin/install_plugins" ]]; then
  "$TPM_DIR/bin/install_plugins" >/dev/null 2>&1 && echo "  plugins installed"
fi

# Pick up the new config if a server is already running.
if command -v tmux >/dev/null 2>&1 && tmux info >/dev/null 2>&1; then
  tmux source-file "$HOME/.tmux.conf" 2>/dev/null && echo "  reloaded running server"
fi

echo "  done"
