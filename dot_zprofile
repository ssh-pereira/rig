# ─────────────────────────────────────────────────────────────
#  ~/.zprofile — login shell environment (runs before ~/.zshrc)
# ─────────────────────────────────────────────────────────────

# Homebrew on PATH (Apple Silicon, then Intel fallback)
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# Homebrew hardening
export HOMEBREW_NO_ANALYTICS=1          # no telemetry
export HOMEBREW_NO_INSECURE_REDIRECT=1  # refuse https -> http redirects on downloads
export HOMEBREW_NO_ENV_HINTS=1

# OrbStack CLI integration (docker, orb) — added here instead of letting the app
# edit this file itself.
[[ -f ~/.orbstack/shell/init.zsh ]] && source ~/.orbstack/shell/init.zsh 2>/dev/null
