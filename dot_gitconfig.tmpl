{{/*
  Templated so one file works on every machine.
  Author email is `gitEmail` from .chezmoidata.toml (the GitHub noreply
  address) on every machine. Work machines also include ~/.gitconfig-hill for
  repos under ~/dev/hill; a chezmoi script keeps its user.email on noreply too.

  Work machines additionally include ~/.gitconfig-hill for repos under ~/dev/hill
  — that file is NOT tracked here, because it holds employer-specific config that
  belongs beside the employer's code, not in a personal repo.
*/ -}}
[user]
	name = {{ .name }}
	# GitHub noreply address everywhere (see .chezmoidata.toml for why).
	email = {{ .gitEmail }}
	# Dedicated SSH signing key (separate from the auth key). Loaded into the
	# macOS ssh-agent at login, so signing never prompts — agents can commit freely.
	signingkey = {{ .chezmoi.homeDir }}/.ssh/github_signing.pub

[core]
	excludesfile = {{ .chezmoi.homeDir }}/.gitignore_global
	pager = delta

# ---------- signing: every commit and tag, via SSH (no GPG) ----------
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = {{ .chezmoi.homeDir }}/.ssh/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true

# ---------- integrity: reject corrupt or malicious objects on fetch ----------
[transfer]
	fsckObjects = true
[fetch "fsck"]
	zeroPaddedFilemode = warn
[receive "fsck"]
	zeroPaddedFilemode = warn
[protocol "file"]
	allow = user

# Pushes to GitHub always go over SSH (your key), even from an https remote.
# Fetches of https URLs stay https, so Homebrew, plugin managers and package
# tools keep working anonymously. Clone private repos with the git@ URL
# (gh is set to git_protocol=ssh, so `gh repo clone` does that already).
[url "git@github.com:"]
	pushInsteadOf = https://github.com/

{{ if eq .machine "work" -}}
# Work identity, auto-applied to anything under ~/dev/hill.
# ~/.gitconfig-hill is intentionally untracked — create it per machine.
[includeIf "gitdir:~/dev/hill/"]
	path = ~/.gitconfig-hill
{{ end }}

# ---------- delta: syntax-highlighted diffs ----------
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	side-by-side = false
	hyperlinks = true
	syntax-theme = Catppuccin Mocha

# ---------- modern defaults ----------
[init]
	defaultBranch = main
[pull]
	rebase = true                 # linear history, no noise merge commits
[rebase]
	autoStash = true              # no more "cannot pull with uncommitted changes"
	autoSquash = true
[fetch]
	prune = true                  # drop local refs to deleted remote branches
	parallel = 8
[diff]
	algorithm = histogram         # noticeably better diffs than the default
	colorMoved = default
[merge]
	conflictstyle = zdiff3        # conflict markers show the ORIGINAL too
[branch]
	sort = -committerdate         # most recent branches first
[column]
	ui = auto
[push]
	autoSetupRemote = true        # no --set-upstream on first push
[rerere]
	enabled = true                # remember conflict resolutions and replay them
[help]
	autocorrect = prompt

# ---------- aliases ----------
[alias]
	st = status -sb
	lg = log --oneline --graph --decorate --all -30
	last = log -1 HEAD --stat
	undo = reset --soft HEAD~1
	wt = worktree
	dft = difftool --tool=difftastic

[difftool "difftastic"]
	cmd = difft \"$LOCAL\" \"$REMOTE\"
[difftool]
	prompt = false
