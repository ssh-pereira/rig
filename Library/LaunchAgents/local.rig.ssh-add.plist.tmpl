<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.rig.ssh-add</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ .chezmoi.homeDir }}/.local/bin/ssh-load-keys</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>{{ .chezmoi.homeDir }}/Library/Logs/rig-ssh-load-keys.log</string>
  <key>StandardErrorPath</key><string>{{ .chezmoi.homeDir }}/Library/Logs/rig-ssh-load-keys.log</string>
</dict>
</plist>
