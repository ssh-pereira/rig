{{/*
  Runs on `chezmoi init`, once per machine. The answers land in
  ~/.config/chezmoi/chezmoi.toml and drive the templates (currently .gitconfig).

  `machine` controls whether work-specific config is emitted (the includeIf for
  ~/dev/hill). The git author email is NOT prompted: it is `gitEmail` in
  .chezmoidata.toml, the GitHub noreply address, on every machine.
*/ -}}
{{- $machine := promptStringOnce . "machine" "Machine type (work/personal)" "personal" -}}
{{- $name := promptStringOnce . "name" "Full name for git commits" "Hugo Pereira" -}}

# The source of truth lives in a normal dev folder instead of the default
# ~/.local/share/chezmoi, so it's easy to browse, grep and edit directly.
sourceDir = {{ printf "%s/dev/hugo/rig" .chezmoi.homeDir | quote }}

[data]
    machine = {{ $machine | quote }}
    name = {{ $name | quote }}
