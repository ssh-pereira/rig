{{/*
  Runs on `chezmoi init`, once per machine. The answers land in
  ~/.config/chezmoi/chezmoi.toml and drive the templates (currently .gitconfig).

  `machine` controls whether work-specific config is emitted — on a work Mac the
  default git identity stays personal, and repos under ~/dev/hill pick up the
  work identity through an includeIf. That way a personal side project committed
  from the work laptop is never authored with a work email by accident.
*/ -}}
{{- $machine := promptStringOnce . "machine" "Machine type (work/personal)" "personal" -}}
{{- $name := promptStringOnce . "name" "Full name for git commits" "Hugo Pereira" -}}
{{- $personalEmail := promptStringOnce . "personalEmail" "Personal git email (GitHub noreply keeps your real address out of public commits)" "82890773+ssh-pereira@users.noreply.github.com" -}}
{{- $email := "" -}}
{{- if eq $machine "work" -}}
{{-   $email = promptStringOnce . "email" "Work email (repos under ~/dev/hill)" "hugo.pereira@hill.com" -}}
{{- end -}}

# The source of truth lives in a normal dev folder instead of the default
# ~/.local/share/chezmoi, so it's easy to browse, grep and edit directly.
sourceDir = {{ printf "%s/dev/hugo/rig" .chezmoi.homeDir | quote }}

[data]
    machine = {{ $machine | quote }}
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    personalEmail = {{ $personalEmail | quote }}
